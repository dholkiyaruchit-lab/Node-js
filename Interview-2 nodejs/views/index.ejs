<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
 

    <title>Employee List</title>
    <style>
        * {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 30px;
  font-family: Arial, sans-serif;
  background: #f5f5f5;
}

.container {
  width: 100%;
  max-width: 1000px;
  margin: auto;
  background: white;
  padding: 20px;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.top a {
  background: #198754;
  color: white;
  text-decoration: none;
  padding: 9px 15px;
  border-radius: 4px;
}

.search {
  margin-bottom: 15px;
  text-align: right;
}

.search input {
  padding: 8px 10px;
  width: 250px;
  border: 1px solid #ccc;
  border-radius: 3px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead {
  background: #20242a;
  color: white;
}

th,
td {
  padding: 12px 10px;
  text-align: left;
}

th {
  font-size: 14px;
}

tbody tr:nth-child(even) {
  background: #f1f1f1;
}

tbody tr:hover {
  background: #e9e9e9;
}

.employee-image {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border: 1px solid #ccc;
}

.edit {
  color: #198754;
  text-decoration: none;
  font-size: 20px;
  margin-right: 10px;
}

.delete {
  color: #dc3545;
  text-decoration: none;
  font-size: 20px;
}

    </style>

</head>


<body>


<div class="container">


    <div class="top">

        <h2>
            Employee List
        </h2>

        <a href="/add">
            + Add Employee
        </a>

    </div>



        <table>

            <thead>

                <tr>
                    <th>
                        ID
                    </th>

                    <th>
                        Image
                    </th>

                    <th>
                        Name
                    </th>

                    <th>
                        E-Mail
                    </th>

                    <th>
                        Phone
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                <% employees.forEach((employee, index) => { %>

                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>


                        <td>

                            <% if (employee.image) { %>

                                <img
                                    src="<%= employee.image %>"
                                    class="employee-image"
                                >

                            <% } %>

                        </td>


                        <td>
                            <%= employee.name %>
                        </td>


                        <td>
                            <%= employee.email %>
                        </td>


                        <td>
                            <%= employee.phone %>
                        </td>


                        <td>

                            <a
                                href="/edit/<%= employee._id %>"
                                class="edit"
                            >
                                ✏️
                            </a>


                            <a
                                href="/delete/<%= employee._id %>"
                                class="delete"
                                onclick="return confirm('Delete this employee?')"
                            >
                                🗑️
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>
</div>


</body>

</html>